{
  "name": "webdollar-wallet-pwa",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicación PWA modular para WebDollar (WEBD)",
  "scripts": {
    "start": "node scripts/serve.js",
    "build:assets": "node scripts/build-assets.js",
    "probe-mainnet": "node scripts/probe-mainnet.js",
    "probe:socket": "node scripts/probe-native-socket.js",
    "probe:browser-socket": "node scripts/probe-native-browser.js",
    "probe:mining": "node scripts/probe-mining-pool.js",
    "prepare:offline": "node scripts/prepare-offline-voucher.js",
    "test:browser": "playwright test",
    "test": "node --test tests/*.test.mjs",
    "check": "node tests/static-check.mjs",
    "build:apk": "node build-apk.js",
    "build:apk:local": "node build-apk.js --local"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@scure/bip39": "1.6.0",
    "argon2-browser": "1.18.0",
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0"
  }
}
